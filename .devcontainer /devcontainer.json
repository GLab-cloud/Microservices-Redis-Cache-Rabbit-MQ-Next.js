{
  "name": "Node.js Quick RabbitMQ",
  "image": "://microsoft.com",
  
  // 1. Kích hoạt Docker bên trong Codespaces
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },

  // 2. Chuyển tiếp cổng Web UI và Broker ra ngoài
  "forwardPorts": [5672, 15672],
  "portsAttributes": {
    "15672": {
      "label": "RabbitMQ Web UI",
      "onAutoForward": "notify"
    },
    "5672": {
      "label": "RabbitMQ Broker",
      "onAutoForward": "silent"
    }
  },

  // 3. Tải RabbitMQ bản Alpine (Siêu nhẹ) ở chế độ nền khi đã vào Codespaces
  "postCreateCommand": "npm install && docker run -d --name rabbitmq-fast -p 5672:5672 -p 15672:15672 rabbitmq:3-management-alpine"
}
