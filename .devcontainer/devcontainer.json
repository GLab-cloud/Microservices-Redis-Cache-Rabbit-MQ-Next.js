{
  "name": "Node.js Quick RabbitMQ",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:0-20",

  // read RabbitMQ default credentials from the local environment
  "containerEnv": {
    "RABBITMQ_DEFAULT_USER": "${localEnv:RABBITMQ_DEFAULT_USER}",
    "RABBITMQ_DEFAULT_PASS": "${localEnv:RABBITMQ_DEFAULT_PASS}"
  },

  // 1. activate docker in Codespaces
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },

  // 2. forward Ports Web UI and Broker
  "forwardPorts": [5672, 15672, 6379, 3000, 5000, 5001, 5002],
  "portsAttributes": {
    "3000": {
      "label": "Frontend (Next.js)",
      "onAutoForward": "notify"
    },
    "15672": {
      "label": "RabbitMQ Web UI",
      "onAutoForward": "notify"
    },
    "5672": {
      "label": "RabbitMQ Broker",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis Cache",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "docker pull rabbitmq:3-management-alpine & docker pull redis:7-alpine & wait",
  "postStartCommand": "bash ./.devcontainer/start-dev.sh"
}